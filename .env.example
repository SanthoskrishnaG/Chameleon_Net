# ==============================================================================
# Protocol Mimicry Engine - Environment Configuration Template
# Copy this file to '.env' for local customization, or set these in your
# cloud provider dashboard (Render, Railway, Fly.io, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Deployment Binding
# ------------------------------------------------------------------------------
# Port for the Flask HTTP API server (Render automatically sets )
PORT=5000

# Bind host (use 0.0.0.0 for cloud hosting, 127.0.0.1 for local isolation)
HOST=0.0.0.0

# Set to 'true' in cloud hosting to activate production security defaults
DEPLOYMENT_MODE=true

# Set to 'false' in cloud hosting so the HTTP server accepts traffic from the internet
# (TCP/UDP telemetry experiments always remain strictly bound to 127.0.0.1 loopback)
STRICT_LOCAL_IP_GUARD=false

# ------------------------------------------------------------------------------
# 2. CORS & Frontend Origins
# ------------------------------------------------------------------------------
# Comma-separated list of authorized frontend origins that may call this API
# Replace with your actual Vercel deployment URL
ALLOWED_ORIGINS=https://your-project.vercel.app,http://localhost:5000,http://localhost:3000

# Permit Vercel preview deployment URLs (*.vercel.app) to make API requests
ALLOW_VERCEL_PREVIEWS=true

# ------------------------------------------------------------------------------
# 3. Security & Access Control
# ------------------------------------------------------------------------------
# Optional secret token to protect mutating operations (traffic generation, mimicry apply, delete).
# Leave blank to disable authentication for open educational laboratories.
# When set, the frontend must pass this value in the 'X-API-Key' header.
API_KEY=your-strong-random-api-key-here

# ------------------------------------------------------------------------------
# 4. Storage & Persistence (Structured Atomic JSON Datasets)
# ------------------------------------------------------------------------------
# Root directory for mutable data (traces, feature records, datasets)
DATA_DIR=data

# Persistent directory for structured JSON datasets (defaults to DATA_DIR)
STORAGE_DIR=data

# Persistent directory for binary/uploaded payload files
UPLOADS_DIR=data/uploads

# Maximum upload file size in bytes (default: 10MB)
MAX_FILE_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 5. Laboratory Bounding & Safety Limits
# ------------------------------------------------------------------------------
# Maximum number of concurrent experiment executions
MAX_ACTIVE_EXPERIMENTS=3

# Maximum packets per generated experiment
MAX_PACKET_COUNT=1000

# Maximum byte size per individual packet
MAX_PACKET_SIZE=1500

# Maximum character length for custom text transmissions
MAX_TEXT_LENGTH=5000
