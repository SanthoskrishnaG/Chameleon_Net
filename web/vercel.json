{
  "": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/generator", "destination": "/generator.html" },
    { "source": "/features", "destination": "/features.html" },
    { "source": "/classifier", "destination": "/classifier.html" },
    { "source": "/mimicry", "destination": "/mimicry.html" },
    { "source": "/comparison", "destination": "/comparison.html" },
    { "source": "/results", "destination": "/results.html" },
    { "source": "/settings", "destination": "/settings.html" },
    { "source": "/demo", "destination": "/demo.html" }
  ]
}
